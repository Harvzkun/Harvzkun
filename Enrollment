import java.util.ArrayList;
import java.util.Scanner;

public class Enrollment {

    // Add a student to the enrollment list
    public static void addStudent(ArrayList<String> enrollmentList, String studentID) {
        if (enrollmentList.contains(studentID)) {
            System.out.println("Student with ID " + studentID + " is already enrolled.");
        } else {
            enrollmentList.add(studentID);
            System.out.println("Student with ID " + studentID + " has been added.");
        }
    }

    // Remove a student from the enrollment list
    public static void removeStudent(ArrayList<String> enrollmentList, String studentID) {
        if (enrollmentList.contains(studentID)) {
            enrollmentList.remove(studentID);
            System.out.println("Student with ID " + studentID + " has been removed.");
        } else {
            System.out.println("Student with ID " + studentID + " is not found in the enrollment list.");
        }
    }

    // Display the list of enrolled students
    public static void displayEnrollment(ArrayList<String> enrollmentList) {
        if (enrollmentList.isEmpty()) {
            System.out.println("The enrollment list is empty.");
        } else {
            System.out.println("Current Enrollment List:");
            for (String student : enrollmentList) {
                System.out.println(student);
            }
        }
    }

    // Search for a student in the enrollment list
    public static void searchStudent(ArrayList<String> enrollmentList, String studentID) {
        if (enrollmentList.contains(studentID)) {
            System.out.println("Student with ID " + studentID + " is enrolled.");
        } else {
            System.out.println("Student with ID " + studentID + " is not enrolled.");
        }
    }

    // Main menu-driven program
    public static void main(String[] args) {
        ArrayList<String> enrollmentList = new ArrayList<>();
        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.println("\nStudent Enrollment System Menu:");
            System.out.println("1. Add Student");
            System.out.println("2. Remove Student");
            System.out.println("3. Display Enrollment List");
            System.out.println("4. Search for Student");
            System.out.println("5. Exit");
            System.out.print("Enter your choice (1-5): ");
            int choice = scanner.nextInt();
            scanner.nextLine(); // Consume the newline

            switch (choice) {
                case 1:
                    System.out.print("Enter the Student ID to add: ");
                    String addID = scanner.nextLine();
                    addStudent(enrollmentList, addID);
                    break;
                case 2:
                    System.out.print("Enter the Student ID to remove: ");
                    String removeID = scanner.nextLine();
                    removeStudent(enrollmentList, removeID);
                    break;
                case 3:
                    displayEnrollment(enrollmentList);
                    break;
                case 4:
                    System.out.print("Enter the Student ID to search: ");
                    String searchID = scanner.nextLine();
                    searchStudent(enrollmentList, searchID);
                    break;
                case 5:
                    System.out.println("Exiting the program. Goodbye!");
                    scanner.close();
                    return;
                default:
                    System.out.println("Invalid choice. Please enter a number between 1 and 5.");
            }
        }
    }
}
